#include <Servo.h>

// ========== 结构体定义 ==========
struct Joint {
    Servo servo;
    int servoPin;
    int joyPin;
    int angle;
    int minAngle;
    int maxAngle;
    int step;
    bool invert;
};

// ========== 关节数组 ==========
Joint joints[4] = {
    // servo, servoPin, joyPin, angle, min, max, step, invert
    { {}, 11, A0, 90, 0, 180, 2, false },  // 底座
    { {}, 10, A1, 90, 0, 180, 2, true  },  // 肩部
    { {},  9, A2, 90, 0, 180, 2, false },  // 肘部
    { {},  6, A3, 35, 0,  70, 2, false },  // 夹爪
};

const int DEADZONE = 50;

void setup() {
  Serial.begin(9600);

  for (int i = 0; i < 4; i++) {
    joints[i].servo.attach(joints[i].servoPin);
    joints[i].servo.write(joints[i].angle);
  }

  delay(500);
  Serial.println("MeArm ready.");
}

void loop() {
  handleJoystick();
  handleSerial();
}

// ========== 摇杆控制 ==========
void handleJoystick() {
  for (int i = 0; i < 4; i++) {
    int joyVal = analogRead(joints[i].joyPin);

    if (abs(joyVal - 512) > DEADZONE) {
      int dir = (joyVal > 512) ? 1 : -1;
      if (joints[i].invert) dir = -dir;

      joints[i].angle += dir * joints[i].step;
      joints[i].angle = constrain(joints[i].angle, joints[i].minAngle, joints[i].maxAngle);
      joints[i].servo.write(joints[i].angle);
    }
  }
  delay(15);
}

// ========== 串口指令 ==========
void handleSerial() {
  if (Serial.available() > 0) {
    String cmd = Serial.readStringUntil('\n');
    cmd.trim();

    if (cmd == "O") {
      joints[3].angle = joints[3].maxAngle;
      joints[3].servo.write(joints[3].angle);
      Serial.println("Claw OPEN");
    }
    else if (cmd == "S") {
      joints[3].angle = joints[3].minAngle;
      joints[3].servo.write(joints[3].angle);
      Serial.println("Claw CLOSE");
    }
    else if (cmd.startsWith("x")) {
      int x, y, z;
      if (sscanf(cmd.c_str(), "x%d,y%d,z%d", &x, &y, &z) == 3) {
        int vals[3] = { x, y, z };
        for (int i = 0; i < 3; i++) {
          joints[i].angle = constrain(vals[i], joints[i].minAngle, joints[i].maxAngle);
          joints[i].servo.write(joints[i].angle);
        }
        Serial.println("Multi-servo OK");
      }
    }
  }
}

// ========== 回中 ==========
void moveToHome() {
  int home[4] = { 90, 90, 90, 35 };
  for (int i = 0; i < 4; i++) {
    joints[i].angle = home[i];
    joints[i].servo.write(joints[i].angle);
  }
  delay(500);
}
