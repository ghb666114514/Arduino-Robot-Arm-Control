#include <Servo.h>
//1.函数声明区---------
void gohome();//回中函数
void serial_handle();//串口指令读取与处理
void joystick_handle();//摇杆指令处理
void angle_print();
//------------------
Servo base,larm,rarm,claw//创建舵机对象

//2.DSD 与 step 与 死区
int DSD = 15; //摇杆延时
int step = 3; //摇杆步进
int deadzone = 50;

//3.当前舵机角度
int base_angle = 90;
int larm_angle = 90;
int rarm_angle = 90;
int claw_angle = 90;

//4.极限角度区
const int basemin=0;
const int basemax=180;
const int larmmin=0
const int larmmax=180;
const int rarmmin=0
const int rarmmax=180;
const int clawopen=0
const int clawoff=180;

void setup()
{
  serial.begin(9600);//开启串口通信
  base.attach(9);
  delay(200);
  larm.attach(8);
  delay(200);
  rarm.attach(7);
  delay(200);
  claw.attach(6);
  delay(200);
  gohome();//上电回中
  Serial.println("meArm ready!请发送指令:O/S/H/L/I/P");
  Serial.println("或发送多电机协同控制指令,x控制底座,y控制左臂,z控制右臂,格式为x30,y45,z60");
}

void loop()
{

}

//函数定义区-----------------
void gohome()
{
  base_angle=90;
  larm_angle=90;
  rarm_angle=90;
  claw_angle=90;
  base.write(90);
  delay(300);
  larm.write(90);
  delay(300);
  rarm.write(90);
  delay(300);
  claw.write(90);
  delay(300);
}

void serial_handle()
{
  if(Serial.available()>0)
  {
    String cmd = readStringUntil('\n');
    cmd.trim();

    if(cmd=="O")
    {
      claw_angle = claw_open;
      claw.write(claw_open);
      Serial.println(Claw open!);
    }

    else if(cmd=="S")
    {
      claw_angle = claw_off;
      claw.write(claw_off);
      Serial.println(Claw close!);
    }

    else if(cmd=="H")
    {
      DSD = max(5, DSD - 3);
      step = min(15, step + 3);
      Serial.print("Speed up! DSD=");
      Serial.print(DSD);
      Serial.print(", step=");
      Serial.println(step);
    }
    
    else if(cmd=="L")
    {
      DSD = min(30, DSD + 5);
      step = max(1, step - 3);
      Serial.print("Speed low! DSD=");
      Serial.print(DSD);
      Serial.print(", step=");
      Serial.println(step);
    }

    else if(cmd=="I")
    {
      gohome();
    }
    
    else if(cmd=="P")
    {
      Serial.println("---- 当前角度 ----");
      Serial.print("base = ");
      Serial.println(base_angle);
      Serial.print("larm = ");
      Serial.println(larm_angle);
      Serial.print("rarm = ");
      Serial.println(rarm_angle);
      Serial.print("claw = ");
      Serial.println(claw_angle);
      Serial.println("------------------");
    }
    //多舵机协同控制
    else if(cmd.startswith("x"))
    {
      char t=Serial.read();
      base_angle=Serial.read();
      char t=Serial.read();
      larm_angle=Serial.read();
      char t=Serial.read();
      rarm_angle=Serial.read();
      base.write(base_angle);
      delay(300);
      larm.write(larm_angle);
      delay(300);
      rarm.write(rarm_angle);
      delay(300);
    }
    else
    {
      Serial.println("指令错误！");
    }
  }

}

void joystick_handle() {
  int joy1_x=analogread(A0);//底座
  int joy1_y=analogread(A1);//larm
  int joy2_x=analogread(A2);//爪子
  int joy2_y=analogread(A3);//rarm
if(abs(joy1_x-512)>deadzone)
{
  base_angle+=(joy1_x>512?step:-step);
  base_angle=constrain(base_angle,basemin,basemax);
  base.write(base_angle);
  delay(DSD);
}
else if(abs(joy1_y-512)>deadzone)
{
  larm_angle+=(joy1_y>512?step:-step);
  larm_angle=constrain(larm_angle,larmmin,larmmax);
  larm.write(larm_angle);
  delay(DSD);
}
if(abs(joy2_x-512)>deadzone)
{
  claw_angle+=(joy2_x>512?step:-step);
  claw_angle=constrain(claw_angle,clawoff,clawopen);
  claw.write(claw_angle);
  delay(DSD);
}
if(abs(joy2_y-512)>deadzone)
{
  rarm_angle+=(joy2_y>512?step:-step);
  rarm_angle=constrain(rarm_angle,rarmmin,rarmmax);
  rarm.write(rarm_angle);
  delay(DSD);
}
