#include <Servo.h>
//1.舵机引脚区
#define basepin  D9
#define leftpin  D8
#define rightpin D7
#define clawpin  D6

//2.极限角度区
const int basemax  = 180;
const int basemin  = 0;
const int leftmax  = 35;
const int leftmin  = 100;
const int rightmax = 45;
const int rightmin = 75;
const int clawopen = 100;
const int clawoff  = 15;

//3.函数定义区
void serial_handle();//串口数据处理函数
void move_home();//上电回中函数 

//4.创建舵机对象
Servo base;
Servo left;
Servo right;
Servo claw;
//5.定义DSD
int DSD=15;
//6.定义摇杆步进
int step =2;
//7.定义当前角度
int base_angle=90;
int left_angle=90;
int right_angle=90;
int claw_angle=35;
//8.回中角度区
const int base_homeangle=90;
const int left_homeangle=90;
const int right_homeangle=90;
const int claw_homeangle=clawoff;
//9.摇杆引脚区
#define joyx_pin A0
#define joyy_pin A1

void setup()
{
    Serial.begin(9600);//启动串口通信
    base.write(basepin);
    delay(200);
    left.write(leftpin);
    delay(200);
    right.write(rightpin);
    delay(200);
    claw.write(clawpin);
    delay(200);
    move_home();//上电回中
    Serial.println("Init finish!");
    delay(500);
}

void loop()
{
     serial_handle();
}

//函数定义区
//1.串口处理函数
void serial_handle()
{
    if(Serial.available()!=0)
    {
        String cmd = Serial.readStringUntil('\n');
        cmd.trim();
        //O
        if(cmd=="O")
        {
           for(int i = claw_angle;i<=clawopen;i++)
           {
                claw.write(i);
                delay(DSD);
           }
           claw_angle=clawopen;
           Serial.println("Claw open!");
        }

       else if(cmd=="S")
       {
        for(int i = claw_angle;i>=clawoff;i--)
           {
                claw.write(i);
                delay(DSD);
           }
           claw_angle=clawoff;
           Serial.println("Claw close!");
       }
       else if(cmd=="H")
       {
        DSD=max(5,DSD-3);
        Serial.print("Speed up!speed:");
        Serial.print(DSD);
    }
    else if(cmd=="L") {
        DSD=min(30,DSD+3);
        Serial.print("Speed low!speed:");
        Serial.print(DSD);
    }
    else if(cmd.startsWith("x"))
    {
        int x,y,z;
        if (sscanf(cmd.c_str(), "x%d,y%d,z%d", &x, &y, &z) == 3)
        {
            //x对应base y对应left z对应right
            base_angle = constrain(x,basemin,basemax);
            base.write(base_angle);
            delay(30);
            left_angle = constrain(y,leftmin,leftmax);
            left.write(left_angle);
            delay(30);
            right_angle=constrain(z,rightmin,rightmax);
            right.write(right_angle);
            delay(30);
        }

        
    }
    else Serial.print("cmd ERROR!");
    
}}

//2.回中函数
void move_home()
{
    base.write(base_homeangle);
    left.write(left_homeangle);
    right.write(right_homeangle);
    claw.write(claw_homeangle);
    base_angle=base_homeangle;
    left_angle = left_homeangle;
    right_angle = right_homeangle;
    claw_angle = clawoff;
    delay(30);
}

